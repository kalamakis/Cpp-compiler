typedef int myint;

const int    MAX_COUNT = 10;
const float  PI        = 3.14;
const char   CH        = 'A';
const string MSG       = "hello";

enum Color {
    RED = 1,
    GREEN,
    BLUE = 10,
    YELLOW
};

int    a;
float  b;
Color  c;

int foo(int x) {
    int y;
    y = x + MAX_COUNT;
    return y;
}

int bar(Color col, int k) {
    int r;
    r = k;
    if (col == GREEN) {
        r = r + 1;
    }
    if (col == BLUE) {
        r = r + 2;
    }
    return r;
}

int main() {
    a = 1;
    b = 2.0;
    c = GREEN;

    if (a) {
        b = b + foo(a);
    }

    c = BLUE;
    a = bar(c, a);

    return 0;
}
