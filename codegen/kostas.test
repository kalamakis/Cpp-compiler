
int main() {
    float a, b, sum, div;
    int i;
    string s;

    // 1. Δοκιμή Ανάθεσης και Πράξεων Float
    a = 10.5;
    b = 2.5;
    
    sum = a + b; // Πρέπει να βγάλει 13.00
    div = a / b; // Πρέπει να βγάλει 4.20

    cout << "A=" << a << ", B=" << b << "\n";
    cout << "Sum (13.0): " << sum << "\n";
    cout << "Div (4.2): " << div << "\n";

    // 2. Δοκιμή Σύγκρισης Float (Coprocessor Flags)
    if (div > 4.0) {
        cout << "Success: 4.2 is greater than 4.0\n";
    } else {
        cout << "Failure: Comparison logic error\n";
    }

    if (sum == 13.0) {
        cout << "Success: Sum is exactly 13.0\n";
    }

    // 3. Δοκιμή Strings και Εισόδου (Cin)
    s = "Enter an integer: ";
    cout << s;
    
    cin >> i;
    cout << "You entered: " << i << "\n";

    return 0;
}